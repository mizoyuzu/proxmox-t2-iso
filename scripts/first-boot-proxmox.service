[Unit]
Description=First boot provisioning: Proxmox VE install and T2 kernel pin
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/first-boot-proxmox.done

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=3600
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/usr/local/sbin/first-boot-proxmox.sh
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
